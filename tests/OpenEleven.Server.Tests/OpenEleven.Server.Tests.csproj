<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\OpenEleven.Protocol.Tests\goldens.json" Link="goldens.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The registration markup with its layout and stylesheet, copied in as plain files so
    RegistrationMarkupTests can read them. A .cshtml is inert here: this is not a Web SDK project, so nothing compiles it.
  -->
  <ItemGroup>
    <None Include="..\..\src\OpenEleven.Server\Pages\Register.cshtml" Link="Register.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OpenEleven.Server\Pages\Shared\_Layout.cshtml" Link="_Layout.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OpenEleven.Server\wwwroot\css\site.css" Link="site.css"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenEleven.Server\OpenEleven.Server.csproj" />
  </ItemGroup>

</Project>
