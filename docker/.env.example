# Copy to docker/.env and edit.
PES_DOMAIN=pes.example.com
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Registration captcha (empty = use the YAML, which defaults to None).
# CAPTCHA_PROVIDER: Turnstile | HCaptcha | ReCaptcha
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Admin portal at /admin, one password per title (empty = that title's portal is off).
# At least 12 characters; use a different one for each title.
ADMIN_USER=admin
ADMIN_PASSWORD_PES2010=
ADMIN_PASSWORD_PES2011=
ADMIN_PASSWORD_PES2012=
ADMIN_PASSWORD_PES2013=
