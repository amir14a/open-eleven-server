@model IReadOnlyList<MatchRow>
@if (Model.Count == 0)
{
    <p class="empty">No matches played yet.</p>
}
else
{
    <div class="scroll">
        <table class="list">
            <thead><tr><th>Date (UTC)</th><th class="num">Home</th><th class="center">Score</th><th>Away</th><th></th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                var m = row.Match;
                <tr>
                    <td class="muted">@SiteData.Date(m.PlayedAt)</td>
                    <td class="num"><a href="/players/@m.HomePid">@row.Home</a></td>
                    <td class="center score">@m.HomeScore &ndash; @m.AwayScore</td>
                    <td><a href="/players/@m.AwayPid">@row.Away</a></td>
                    <td>
                        @if (m.Ranked) { <span class="tag lime">Ranked</span> }
                        @if (m.ExtraTime) { <span class="tag">ET</span> }
                        @if (m.Penalties) { <span class="tag">Pens</span> }
                        @if (m.Disconnected) { <span class="tag red">Disconnect</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
